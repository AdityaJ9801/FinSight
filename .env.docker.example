# Env file for `docker compose up` (see docker-compose.yml). Differs from .env.example
# only in the hostnames: services reach each other by Compose service name (`redis`), not
# `localhost`, and storage is an absolute path inside the container's mounted volume.

FLASK_SECRET_KEY=change-me-dev-secret
FLASK_DEBUG=true

# Relative to app.instance_path (== /app/instance, the mounted "instance_data" volume).
DATABASE_URL=sqlite:///finsight.db
STORAGE_ROOT=/app/instance/storage

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# LLM_BACKEND options:
#   auto              = automatically selects whichever provider has an API key configured (openai -> gemini -> custom -> fake)
#   reasoning         = auto-selects provider with an API key and uses its reasoning model (e.g. gpt-4o or gemini-1.5-pro)
#   openai            = pin OpenAI standard model (OPENAI_MODEL_NAME)
#   openai_reasoning  = pin OpenAI reasoning model (OPENAI_REASONING_MODEL_NAME)
#   gemini            = pin Gemini standard model (GEMINI_MODEL_NAME)
#   gemini_reasoning  = pin Gemini reasoning model (GEMINI_REASONING_MODEL_NAME)
#   real              = pin custom endpoint
#   fake              = offline mock client (no API calls)
LLM_BACKEND=auto

# =====================================================================
# 1. OpenAI Configuration (Paste your OpenAI API Key here)
# =====================================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_REASONING_MODEL_NAME=gpt-4o

# =====================================================================
# 2. Gemini Configuration (Paste your Google Gemini API Key here)
# =====================================================================
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_REASONING_MODEL_NAME=gemini-1.5-pro

# =====================================================================
# 3. Custom-deployed endpoint (Optional)
# =====================================================================
# If your custom LLM is deployed on the host machine (not in Docker), point at it via
# Docker Desktop's host gateway instead of localhost, e.g.:
#   LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=
LLM_MODEL_NAME=custom-model

# =====================================================================
# Concurrency & Performance
# =====================================================================
# Parallel calls: true allows multiple agent LLM calls in parallel (up to LLM_MAX_CONCURRENT_REQUESTS)
LLM_PARALLEL_CALLS=true
LLM_MAX_CONCURRENT_REQUESTS=5
LLM_MAX_TOKENS=8192

WEB_SEARCH_ENABLED=true
WEB_SEARCH_NUM_RESULTS=3
WEB_SEARCH_LINES_PER_RESULT=6
WEB_SEARCH_TIMEOUT_S=10

# --- Pipeline Behavior ---
# If true, low-confidence row mappings flag gaps but allow automated pipeline progress
# (instead of stopping the job at AWAITING_REVIEW for every uncertain account guess).
AUTO_APPROVE_LOW_CONFIDENCE=true
# A reconciliation check failing by less than this (relative to its expected value) logs a
# gap and lets the pipeline continue too -- e.g. a subset chart-of-accounts missing a
# granular statement caption can legitimately leave a bounded gap that isn't a data error.
# Raise it if you want larger gaps to auto-pass too; a NO_FACTS check (empty dataset)
# always blocks regardless of this setting.
RECONCILIATION_MATERIALITY_PCT=0.15

OCR_ENABLED=false
