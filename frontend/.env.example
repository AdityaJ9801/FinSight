# Where the web app sends API requests.
#
# Leave unset when the app and the API share an origin: the Vite dev server (npm run dev),
# `npm run preview` and the nginx Docker image all forward /api to the backend.
#
# Set it when the frontend is hosted separately from the backend, e.g. on Vercel or Netlify,
# to the backend's public URL including /api. It's baked in at build time.
# VITE_API_BASE=https://finsight-api.example.com/api

# Dev/preview proxy target (Vite only, not baked into the build).
# FINSIGHT_API=http://127.0.0.1:5000
